{
  "name": "tft-stats",
  "productName": "TFT Stats",
  "version": "1.3.0",
  "description": "Statistiques Teamfight Tactics en direct : compos méta, champions, objets, augments et recherche joueur.",
  "author": "Mika",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "start:demo": "electron . --demo",
    "web": "node web/server.js",
    "web:demo": "node web/server.js --demo",
    "test": "node test/engine.test.js",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "fr.tftstats.app",
    "productName": "TFT Stats",
    "copyright": "TFT Stats n'est pas approuvé par Riot Games.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "core/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "TFT-Stats-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TFT Stats",
      "uninstallDisplayName": "TFT Stats",
      "language": "1036"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ZayKololo",
        "repo": "tft-stats",
        "releaseType": "release"
      }
    ]
  }
}
