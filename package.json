{
  "name": "tft-stats",
  "productName": "HexaRise",
  "version": "1.11.1",
  "description": "HexaRise, compagnon TFT : méta par rang, guides étape par étape et mode partie, en français.",
  "author": "Hexa Labs",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/HexaLabsFR/tft-stats.git"
  },
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "start:demo": "electron . --demo",
    "web": "node web/server.js",
    "web:demo": "node web/server.js --demo",
    "test": "node test/engine.test.js",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "fr.tftstats.app",
    "productName": "HexaRise",
    "copyright": "© 2026 Hexa Labs · HexaRise n'est pas approuvé par Riot Games.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "core/**/*",
      "content/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "HexaRise-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HexaRise",
      "uninstallDisplayName": "HexaRise",
      "language": "1036"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HexaLabsFR",
        "repo": "tft-stats",
        "releaseType": "release"
      }
    ]
  }
}
